# ==============================================================================
# Environment variable template for local PayMesh development.
# Spring Boot does not load this file automatically. Set these in your shell or IDE.
# Replace every example value locally; never commit actual credentials.
# ==============================================================================

# Database Connection (PayMesh Docker PostgreSQL 16)
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/paymesh_dev
SPRING_DATASOURCE_USERNAME=paymesh_dev
SPRING_DATASOURCE_PASSWORD=replace_with_paymesh_dev_password

# Shared demo dashboard/API access. Use a unique random password for public hosting.
PAYMESH_DEMO_USERNAME=replace_with_demo_username
PAYMESH_DEMO_PASSWORD=replace_with_long_random_password
PAYMESH_DEMO_WRITES_ENABLED=true
PAYMESH_API_WRITE_LIMIT_PER_MINUTE=60

# Server Port
SERVER_PORT=8080

# Logging Level
LOGGING_LEVEL_COM_DEMO_UPIMESH=INFO

# Educational Offline Mesh TTL Windows (in seconds)
UPI_MESH_IDEMPOTENCY_TTL_SECONDS=86400
UPI_MESH_PACKET_MAX_AGE_SECONDS=86400
